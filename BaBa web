  <style>
    #topBtn {
  
      position: fixed;
      bottom: 30px;
      right: 30px;
      width: 60px;
      height: 60px;
      border: none;
      border-radius: 50%;
      background: #00ffff;
      color: #07102e;
      font-size: 30px;
      cursor: pointer;
      display: none;
      transition: .35s;
      box-shadow: 0 0 25px cyan;
      z-index: 999;
  
    }
  
    #topBtn:hover {
  
      transform: translateY(-8px) scale(1.1);
  
    }
  
    .fade {
  
      opacity: 0;
      transform: translateY(80px);
      transition: 1s;
  
    }
  
    .fade.active {
  
      opacity: 1;
      transform: translateY(0);
  
    }
  
    .hero::before {
  
      content: "";
      position: absolute;
      width: 800px;
      height: 800px;
      background: radial-gradient(cyan, transparent 70%);
      opacity: .08;
      filter: blur(40px);
      animation: spinGlow 20s linear infinite;
  
    }
  
    @keyframes spinGlow {
  
      0% {
  
        transform: rotate(0deg) scale(1);
  
      }
  
      50% {
  
        transform: rotate(180deg) scale(1.15);
  
      }
  
      100% {
  
        transform: rotate(360deg) scale(1);
  
      }
  
    }
  
    .service,
    .card,
    .why-card,
    .stat {
  
      transition: .45s;
  
    }
  
    .service:hover,
    .card:hover,
    .why-card:hover,
    .stat:hover {
  
      transform: translateY(-10px);
  
      box-shadow: 0 0 40px rgba(0, 255, 255, .45);
  
    }
  
    body {
  
      background-image:
        radial-gradient(circle at top left, #0a2d62 0%, transparent 30%),
        radial-gradient(circle at bottom right, #003d4d 0%, transparent 35%);
  
    }
  </style>
  
  <button id="topBtn">
  
  ↑
  
  </button>
  <script>
    const topBtn=document.getElementById("topBtn");
  
  window.addEventListener("scroll",()=>{
  
  if(window.scrollY>300){
  
  topBtn.style.display="block";
  
  }else{
  
  topBtn.style.display="none";
  
  }
  
  });
  
  topBtn.onclick=()=>{
  
  window.scrollTo({
  
  top:0,
  
  behavior:"smooth"
  
  });
  
  };
  
  const observer=new IntersectionObserver((entries)=>{
  
  entries.forEach(entry=>{
  
  if(entry.isIntersecting){
  
  entry.target.classList.add("active");
  
  }
  
  });
  
  });
  
  document.querySelectorAll("section").forEach(section=>{
  
  section.classList.add("fade");
  
  observer.observe(section);
  
  });
  
  const cards=document.querySelectorAll(".card,.service,.why-card,.stat");
  
  cards.forEach(card=>{
  
  card.addEventListener("mouseenter",()=>{
  
  card.style.transform="translateY(-12px)";
  
  });
  
  card.addEventListener("mouseleave",()=>{
  
  card.style.transform="translateY(0px)";
  
  });
  
  });
  
  const navLinks=document.querySelectorAll("nav a");
  
  navLinks.forEach(link=>{
  
  link.addEventListener("mouseenter",()=>{
  
  link.style.textShadow="0 0 15px cyan";
  
  });
  
  link.addEventListener("mouseleave",()=>{
  
  link.style.textShadow="none";
  
  });
  
  });
  
  </script>
